# Copy to .env and fill in the real values. Never commit .env.

# --- Database (Prisma / SQLite) ---
DATABASE_URL="file:./db/custom.db"

# --- Telegram bot ---
# Get the token from @BotFather.
TELEGRAM_BOT_TOKEN="123456789:AA-your-bot-token-here"
# Public https URL Telegram posts updates to.
TELEGRAM_WEBHOOK_URL="https://your-domain.example.com/api/telegram/webhook"
# Any long random string; Telegram echoes it in the secret_token header.
TELEGRAM_WEBHOOK_SECRET="change-me-to-a-random-secret"
# Optional: comma-separated chat IDs allowed to talk to the bot. Empty = anyone.
TELEGRAM_ALLOWED_CHAT_IDS=""

# --- AI backend (optional) ---
# These override the Settings dialog. Leave unset to configure in the app.
# AI_BACKEND="zai"            # zai | openai-compat
# OPENAI_BASE_URL="https://api.example.com/v1"
# OPENAI_API_KEY=""
# OPENAI_MODEL=""

# --- Song audio engine (optional) ---
# AUDIO_ENGINE="zai"          # zai | acestep
# ACESTEP_BASE_URL="http://localhost:8001"
# ACESTEP_MODEL="acestep/acestep-v15-turbo"
# ACESTEP_API_KEY=""

# --- Transcription (optional) ---
# Groq key for Whisper: times the stickman to the vocals, transcribes dropped-in MP3s.
# A key saved in Settings wins over this one.
# GROQ_API_KEY=""
# WHISPER_MODEL="whisper-large-v3"   # or whisper-large-v3-turbo (faster, less accurate)

# --- Misc (optional) ---
# PUBLIC_BASE_URL="https://your-domain.example.com"
# APP_INTERNAL_URL="http://127.0.0.1:3000"
