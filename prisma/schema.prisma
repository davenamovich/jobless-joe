// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A single generated Jobless Joe song episode, with all its companion outputs.
model Episode {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())

  /// The selected theme key (e.g. "joe-discovers-ai") OR "custom"
  episodeTheme  String
  /// Display label of the chosen theme
  episodeLabel  String
  /// If user typed a custom topic, it lives here
  customTopic   String?
  /// Optional per-episode script the song was built from. Joe keeps its beats
  /// and facts but rewrites them into his own voice, so this is an input we
  /// keep forever (unlike the lyrics, which live in `output`).
  customScript  String?

  /// Selected song duration: 15s / 30s / 60s / 90s / 120s
  duration      String
  /// Comedy intensity: dry-wit / deadpan / ridiculous / savage-roast / unhinged
  intensity     String
  /// Target audience key
  target        String
  /// Crooner style key (e.g. "smoky-lounge", "big-band-vegas")
  croonerStyle  String   @default("smoky-lounge")
  /// Output language key from LANGUAGES (e.g. "en", "es", "pt-BR")
  language      String   @default("en")

  /// Which AI backend produced this episode: "zai" | "openai-compat"
  backend       String   @default("zai")
  /// Model name as reported by the backend (e.g. "glm-4.6", "ace-1.5", "llama-3.1-70b")
  backendModel  String?

  /// Which action produced this episode (generate / funnier / sharper / attitude / bigger-ending / thirty-ad / continue / alt-hooks)
  action        String

  /// Episode title shown to user (e.g. "Joe Discovers AI")
  title         String
  /// The full song output serialized as JSON
  output        String

  /// Short teaser line shown on cards
  teaser        String
  /// Suggested next episode title
  nextTitle     String

  /// Optional reference to a previous episode when continuing a story
  previousId    String?

  @@index([createdAt])
}

/// A single growing Story Bible. Only one row exists at id = "current".
model StoryBible {
  id                    String   @id @default("current")
  updatedAt             DateTime @updatedAt

  /// Joe's current situation in the story (1-3 sentences)
  currentSituation      String

  /// JSON array of skills Joe has learned so far
  learnedSkills         String   // "[]"

  /// JSON array of things Joe has built or made
  builtThings           String   // "[]"

  /// JSON array of recurring character names + short traits
  characters            String   // "[]"

  /// JSON array of running jokes
  runningJokes          String   // "[]"

  /// JSON array of past punchlines worth remembering
  previousPunchlines    String   // "[]"

  /// JSON array of unresolved story threads to revisit
  unresolvedStorylines String   // "[]"

  /// Next planned development hint
  nextDevelopment       String

  /// Total episodes produced so far
  episodeCount          Int      @default(0)
}

/// A branded wall — one per bot/character. Holds a queue of episodes
/// (music videos, in Joe's case) that get displayed on the phone.
model Wall {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Display name, e.g. "Joe's Wall"
  name        String
  /// Brand color as a hex string, e.g. "#722F37"
  brandColor  String   @default("#722F37")
  /// Optional single emoji used as avatar
  emoji       String   @default("🎙️")
  /// Short tagline shown under the wall name
  tagline     String   @default("")

  items       WallItem[]
}

/// One entry in a wall's playback queue. References an Episode.
model WallItem {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())

  wallId      String
  wall        Wall     @relation(fields: [wallId], references: [id], onDelete: Cascade)

  /// The episode this item points to
  episodeId   String

  /// Order in the queue (lower = earlier). 0 is "up next".
  order       Int      @default(0)

  /// queued | playing | played
  status      String   @default("queued")

  @@index([wallId, order])
}

/// Runtime AI backend configuration. Singleton row at id = "current".
/// Allows the user to switch between Z.ai and an OpenAI-compatible endpoint
/// (e.g. Ace 1.5 running locally or behind ngrok) without restarting the server.
model BackendConfig {
  id              String   @id @default("current")
  updatedAt       DateTime @updatedAt

  /// "zai" | "openai-compat"
  activeBackend   String   @default("zai")

  /// OpenAI-compatible base URL, e.g. "https://abc123.ngrok.app/v1" or "http://localhost:1234/v1"
  openaiBaseUrl   String   @default("")
  /// API key for the OpenAI-compat endpoint (may be empty for local models)
  openaiApiKey    String   @default("")
  /// Model name, e.g. "ace-1.5", "llama-3.1-70b", "gpt-4o-mini"
  openaiModel     String   @default("")

  /// Default crooner style key (the user can still override per-generation)
  defaultCroonerStyle String @default("smoky-lounge")

  /// Default TTS voice for audio generation
  defaultVoice    String   @default("jam")

  /// Which engine renders the song audio: "zai" (spoken TTS) | "acestep" (ACE-Step music)
  audioEngine     String   @default("zai")

  /// ACE-Step API base, e.g. "http://localhost:8001" or "https://abc123.ngrok.app".
  /// A trailing /v1 is accepted and normalized away.
  aceStepBaseUrl  String   @default("http://localhost:8001")
  /// ACE-Step model ID as listed by GET /v1/models
  aceStepModel    String   @default("acestep/acestep-v15-turbo")

  /// Plunder & Riffle MCP endpoint (video engine)
  prMcpUrl        String   @default("https://bot.plunderandriffle.com/api/mcp")
  /// Agent API key for Plunder & Riffle (Authorization: Bearer ...)
  prApiKey        String   @default("")
  /// Referral code appended to P&R links (?ref=...) so Joe's traffic is tracked
  prRef           String   @default("")
  /// Public https base that serves /audio/* so P&R can fetch the song.
  /// Empty = publish the MP3 to here.now for each video.
  publicBaseUrl   String   @default("")
  /// Free-course CTA used on the phone, the song page and the video copy
  courseUrl       String   @default("https://www.plunderandriffle.com/joblessjoe")

  /// Google Cloud OAuth client used to upload finished videos to YouTube.
  /// P&R has no YouTube tool, so this is the only route to a real YT upload.
  ytClientId      String   @default("")
  ytClientSecret  String   @default("")
  /// Long-lived refresh token from the consent flow (offline access)
  ytRefreshToken  String   @default("")
  /// Channel resolved from the token, shown in settings as proof it works
  ytChannelId     String   @default("")
  ytChannelTitle  String   @default("")
  /// unlisted | public | private — default to the safe one
  ytPrivacy       String   @default("unlisted")

  /// Upload-Post (upload-post.com) — one API call posts a video to TikTok,
  /// Instagram, YouTube Shorts, X, etc. on the connected profile.
  upApiKey        String   @default("")
  /// Upload-Post profile ("user") the social accounts are connected to
  upUser          String   @default("")
  /// Comma-separated platform[] values, e.g. "tiktok,instagram,youtube"
  upPlatforms     String   @default("tiktok,instagram,youtube")

  /// Autopilot: write + sing a new song on a timer, film it, optionally post it
  autoEnabled     Boolean  @default(false)
  autoIntervalMin Int      @default(60)
  /// Also film the MP4 (P&R credits) and post it via Upload-Post
  autoPublish     Boolean  @default(false)
  /// Telegram chat that hears about each autopilot run (set by /autopilot on)
  autoChatId      String   @default("")
  autoLastRunAt   DateTime?
}

/// A Plunder & Riffle video made from an episode's song.
/// One click starts a job; the row tracks the pack page, its 9:16 assets and
/// the optional MP4 render.
model VideoJob {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  episodeId   String

  /// queued | rendering | ready | mp4_rendering | done | failed
  status      String   @default("queued")

  /// Public https URL of the song handed to P&R
  audioUrl    String   @default("")
  /// The 9:16 /video page P&R returns
  pageUrl     String   @default("")
  /// 9:16 poster/asset used on the phone
  posterUrl   String   @default("")
  /// Finished MP4, when requested
  mp4Url      String   @default("")

  /// Joe-specific caption (hook + closing line + free-course CTA)
  postCopy    String   @default("")

  /// P&R job ids for resuming polls (never resend the audio)
  packJobId   String   @default("")
  mp4JobId    String   @default("")

  /// Raw provider payload, kept for debugging odd shapes
  providerRaw String   @default("")
  error       String   @default("")

  /// Copy of the MP4 on our own disk (/video/<id>.mp4). P&R hosts the render
  /// for ~24h only, so the YouTube upload and the phone read this instead.
  localMp4    String   @default("")

  /// YouTube upload: "" | publishing | published | failed
  ytStatus    String   @default("")
  ytVideoId   String   @default("")
  ytUrl       String   @default("")
  /// True when a caption track (SRT built from the pack page) was uploaded
  ytCaptions  Boolean  @default(false)
  ytError     String   @default("")

  @@index([episodeId, createdAt])
}

/// A generated audio track for an episode — spoken lyrics that play
/// through the Display Phone. One track per (episodeId, voice) pair.
/// Re-generating with a different voice creates a new row.
model AudioTrack {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())

  episodeId   String
  /// Voice key from VOICES (e.g. "jam", "tongtong", "xiaochen")
  voice       String
  /// "wav" | "mp3"
  format      String   @default("mp3")
  /// Speed used (0.5..2.0)
  speed       Float    @default(0.9)
  /// Duration in seconds (rounded), populated after generation
  durationSec Int      @default(0)
  /// Number of TTS chunks that were concatenated
  chunkCount  Int      @default(0)
  /// On-disk relative path under /public/audio/, e.g. "ep_abc_jam.mp3"
  filePath    String

  @@unique([episodeId, voice])
  @@index([episodeId])
}
